// The challenge: the shipping app, which also reports the weight that goes in the van and the heaviest parcel.
string main(string weights, string destination) {
	decimal rate = 0;
	if (destination == "UK") {
		rate = 1;
	} else if (destination == "EU" || destination == "Europe") {
		rate = 1.5;
	} else {
		rate = 3;
	}
	PrintLine("Shipping to " + destination);

	jsonArray parcels = StringSplit(weights, ",", false);
	int boxes = 0;
	decimal total = 0;
	// The new totals start at zero, before the loop, so every turn of the loop adds to the same ones.
	decimal shipped = 0;
	decimal heaviest = 0;
	for (int i = 0; i < JsonArrayCount(parcels); i++) {
		if (boxes == 6) {
			PrintLine("The van is full: the other parcels wait for the next one.");
			break;
		}

		string weight = StringTrim(JsonArrayGetAtIndex(parcels, i));
		if (weight == "") {
			continue;
		}
		if (!TypeIsDecimal(weight)) {
			PrintLine("Skipped \"" + weight + "\": not a weight in kg");
			continue;
		}

		// A parcel only counts once it is past the checks above.
		shipped = shipped + weight;
		if (weight > heaviest) {
			heaviest = weight;
		}

		decimal left = weight;
		while (left > 0) {
			decimal box = MathMin(left, 20);
			left = left - box;

			string size = "";
			decimal price = 0;
			if (box <= 2) {
				size = "small";
				price = 3.5;
			} else if (box <= 10) {
				size = "medium";
				price = 6;
			} else {
				size = "large";
				price = 11;
			}
			price = price * rate;

			boxes = boxes + 1;
			total = total + price;
			PrintLine("Box " + boxes + ": " + box + " kg, " + size + ", " + DecimalToString(price, "0.00"));
		}
	}

	if (destination == "UK" && total >= 40) {
		total = total * 0.9;
		PrintLine("10% off UK orders of 40 or more");
	}
	PrintLine("Total for " + boxes + " boxes: " + DecimalToString(total, "0.00"));
	PrintLine("In the van: " + shipped + " kg. Heaviest parcel: " + heaviest + " kg");
	return(DecimalToString(total, "0.00"));
}
