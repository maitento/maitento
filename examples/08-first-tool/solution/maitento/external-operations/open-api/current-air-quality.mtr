// The second tool. Like current-weather, it fixes `current`, so the model only gives the place.
connector = @ref("open-meteo-air-quality")
bindings.query:current = "european_aqi,pm2_5"
guidance = "Gets the current European air quality index (0-20 good, 20-40 fair, 40-60 moderate, 60-80 poor, 80-100 very poor, over 100 extremely poor) and the PM2.5 level for a place. Work out the latitude and longitude of the place yourself before you call it."
